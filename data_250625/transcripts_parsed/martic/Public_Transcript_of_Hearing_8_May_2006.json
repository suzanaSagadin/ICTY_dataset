{
  "case": "martic",
  "case_id_base": "IT-95-11",
  "case_id_transcript": null,
  "date": "2006-05-08",
  "utterances": [
    {
      "id": 1,
      "speaker": "JUDGE MOLOTO",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "I believe the accused is not in court today. What the Bench knows about his absence is what we got by telephone reports. I don't know if anybody is able to give us any report as to the status of the accused and what should happen from here on. Yes, Mr. Milovancevic?"
    },
    {
      "id": 2,
      "speaker": "MR. MILOVANCEVIC",
      "role": "counsel",
      "is_accused": false,
      "type": "statement",
      "text": "[Interpretation] Your Honour, could we please move into private session?"
    },
    {
      "id": 3,
      "speaker": "JUDGE MOLOTO",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "Yes."
    },
    {
      "id": 4,
      "speaker": "JUDGE MOLOTO",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "I guess this morning we were in closed session when we discussed this matter. Is it necessary to go into private session again? Mr. Milovancevic?"
    },
    {
      "id": 5,
      "speaker": "MR. MILOVANCEVIC",
      "role": "counsel",
      "is_accused": false,
      "type": "statement",
      "text": "[Interpretation] Yes. Perhaps that would be good."
    },
    {
      "id": 6,
      "speaker": "JUDGE MOLOTO",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "Okay. Shall we move into private session, then?"
    },
    {
      "id": 7,
      "speaker": "THE REGISTRAR",
      "role": "registrar",
      "is_accused": false,
      "type": "statement",
      "text": "We are now in open session, Your Honour."
    },
    {
      "id": 8,
      "speaker": "JUDGE MOLOTO",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "Thank you very much. In view of the fact that Mr. Martic, the accused in this case, is reported to be unwell and undergoing some medical checkups, the matter is postponed until tomorrow at 9.00 in the morning, in the same court. Court adjourned."
    },
    {
      "id": 9,
      "speaker": "JUDGE MOLOTO",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "to be reconvened on Tuesday, the 9th day of May, 2006, at 9.00 a.m."
    }
  ],
