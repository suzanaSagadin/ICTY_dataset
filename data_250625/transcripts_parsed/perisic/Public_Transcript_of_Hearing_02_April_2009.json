  "utterances": [
    {
      "id": 1,
      "speaker": "THE REGISTRAR",
      "role": "registrar",
      "is_accused": false,
      "type": "statement",
      "text": "Your Honours, we're back in open session."
    },
    {
      "id": 2,
      "speaker": "JUDGE MOLOTO",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "Thank you so much. Matters stand adjourned to Monday --"
    },
    {
      "id": 3,
      "speaker": "MR. GUY-SMITH",
      "role": "counsel",
      "is_accused": false,
      "type": "statement",
      "text": "Your Honour, if I might just take one very brief matter, and I do apologise. It has come to our attention the Prosecution has recently filed a response to our motion of -- for provisional release with regard to Mr. Perisic over the Easter period of time. If we could be given permission to file a reply to that response to be filed by tomorrow at 10.00, we would appreciate it."
    },
    {
      "id": 4,
      "speaker": "JUDGE MOLOTO",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "Yes."
    },
    {
      "id": 5,
      "speaker": "MR. GUY-SMITH",
      "role": "counsel",
      "is_accused": false,
      "type": "statement",
      "text": "Thank you very much."
    },
    {
      "id": 6,
      "speaker": "JUDGE MOLOTO",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "Thank you very much. Stand adjourned to Monday, the 6th, 9.00 in the morning, Courtroom I. Court adjourned."
    },
    {
      "id": 7,
      "speaker": "JUDGE MOLOTO",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "to be reconvened on Monday, the 6th day of April, 2009, at 9.00 a.m."
    }
  ],
