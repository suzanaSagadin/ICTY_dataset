    {
      "id": 1,
      "speaker": "JUDGE PARKER",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "Good morning, Mr. Stamp."
    },
    {
      "id": 2,
      "speaker": "MR. STAMP",
      "role": "counsel",
      "is_accused": false,
      "type": "statement",
      "text": "Good morning, Your Honours."
    },
    {
      "id": 3,
      "speaker": "JUDGE PARKER",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "We are in open session. Is that where you need to be?"
    },
    {
      "id": 4,
      "speaker": "MR. STAMP",
      "role": "counsel",
      "is_accused": false,
      "type": "statement",
      "text": "With your leave, Your Honours, could we move into private session I would be very grateful."
    },
    {
      "id": 5,
      "speaker": "JUDGE PARKER",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "Private session."
    },
    {
