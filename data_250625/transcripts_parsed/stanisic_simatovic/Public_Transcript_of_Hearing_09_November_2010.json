      "id": 2,
      "speaker": "THE REGISTRAR",
      "role": "registrar",
      "is_accused": false,
      "type": "statement",
      "text": "Good afternoon, Your Honours. Good afternoon, everyone in and around the courtroom. This is the case IT-03-69-T, the Prosecutor versus Jovica Stanisic and Franko Simatovic."
    },
    {
      "id": 3,
      "speaker": "JUDGE ORIE",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "Thank you, Madam Registrar. There is a motion pending which we should deal with in private session."
    },
