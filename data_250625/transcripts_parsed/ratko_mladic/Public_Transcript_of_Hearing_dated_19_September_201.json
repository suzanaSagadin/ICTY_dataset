      "text": "We are in open session, Your Honours."
    },
    {
      "id": 15,
      "speaker": "JUDGE ORIE",
      "role": "judge",
      "is_accused": false,
      "type": "statement",
      "text": "Thank you, Madam Registrar. We adjourn for the day, and we will resume Monday, the 22nd of September, 9.30 in the morning, in this same courtroom, I."
    },
