{
  "case": "plavsic",
  "case_id": "IT-00-39",
  "date": "2005-05-30",
  "utterances": [
    {
      "id": 1,
      "speaker": "JUDGE ORIE",
      "role": "judge",
      "type": "statement",
      "text": "Madam Registrar, would you please call the case."
    },
    {
      "id": 2,
      "speaker": "THE REGISTRAR",
      "role": "registrar",
      "type": "statement",
      "text": "Good afternoon, Your Honours. This is case number IT-00-39-T, the Prosecutor versus Momcilo Krajisnik."
    },
    {
      "id": 3,
      "speaker": "JUDGE ORIE",
      "role": "judge",
      "type": "statement",
      "text": "Thank you very much, Madam Registrar. The next witness the Prosecution will call is a protected witness; pseudonym and closed session, Mr. Tieger, as far as I remember."
    },
    {
      "id": 4,
      "speaker": "MR. TIEGER",
      "role": "counsel",
      "type": "statement",
      "text": "That's quite correct, Your Honour."
    },
    {
      "id": 5,
      "speaker": "JUDGE ORIE",
      "role": "judge",
      "type": "statement",
      "text": "Yes. That means that unless there's anything we should deal with at this moment in open session, that we'll turn into closed session."
    },
    {
      "id": 6,
      "speaker": "MR. STEWART",
      "role": "counsel",
      "type": "statement",
      "text": "That should clear the public gallery quite quickly of the enthusiastic three members, Your Honour, that --"
    },
    {
      "id": 7,
      "speaker": "JUDGE ORIE",
      "role": "judge",
      "type": "statement",
      "text": "Yes."
    },
    {
      "id": 8,
      "speaker": "MR. STEWART",
      "role": "counsel",
      "type": "statement",
      "text": "A disappointing day for them, but ..."
    },
    {
      "id": 9,
      "speaker": "MR. STEWART",
      "role": "counsel",
      "type": "statement",
      "text": "to be reconvened on Tuesday, the 31st day of May, 2005, at 2.15 p.m. 20 21 22 23 24 25"
    }
  ],
