{
  "case": "krajisnik",
  "case_id": "IT-00-39",
  "date": "2006-04-10",
  "utterances": [
    {
      "id": 1,
      "speaker": "JUDGE ORIE",
      "role": "judge",
      "type": "statement",
      "text": "Good morning to everyone. Mr. Registrar, would you please call the case."
    },
    {
      "id": 2,
      "speaker": "THE REGISTRAR",
      "role": "registrar",
      "type": "statement",
      "text": "Good morning, Your Honours. This is case number IT-00-39-T, the Prosecutor versus Momcilo Krajisnik."
    },
    {
      "id": 3,
      "speaker": "JUDGE ORIE",
      "role": "judge",
      "type": "statement",
      "text": "Thank you, Mr. Registrar. Mr. Josse, I think the wisest thing to do would be to go into closed session and then hear the parties first, perhaps, and then, if need be, the witness on protective measures."
    },
    {
      "id": 4,
      "speaker": "MR. JOSSE",
      "role": "counsel",
      "type": "statement",
      "text": "Thank you, Your Honour."
    },
    {
      "id": 5,
      "speaker": "JUDGE ORIE",
      "role": "judge",
      "type": "statement",
      "text": "We turn into private -- in closed session."
    },
    {
      "id": 6,
      "speaker": "JUDGE ORIE",
      "role": "judge",
      "type": "statement",
      "text": "to be reconvened on Tuesday, the 11th day of April, 2006, at 1.30 p.m. 20 21 22 23 24 25"
    }
  ],
