  "utterances": [
    {
      "id": 1,
      "speaker": "JUDGE PARKER",
      "role": "judge",
      "type": "statement",
      "text": "It is unfortunate that our start was delayed because the previous sitting was late finishing. We are now ready, I believe, for the next witness. Could the witness be called."
    },
    {
      "id": 2,
      "speaker": "JUDGE PARKER",
      "role": "judge",
      "type": "statement",
      "text": "The witness is a protected witness, I believe. Is that so?"
    },
    {
      "id": 3,
      "speaker": "MR. NICHOLLS",
      "role": "counsel",
      "type": "statement",
      "text": "Yes, Your Honour. That is so. Good afternoon, Your Honours."
    },
    {
      "id": 4,
      "speaker": "JUDGE PARKER",
      "role": "judge",
      "type": "statement",
      "text": "In that event, we should go into closed session now."
    },
    {
      "id": 5,
      "speaker": "MR. NICHOLLS",
      "role": "counsel",
      "type": "statement",
      "text": "Thank you."
    },
    {
      "id": 6,
      "speaker": "MR. NICHOLLS",
      "role": "counsel",
      "type": "statement",
      "text": "to be reconvened on Thursday, the 25th day of November, 2004, at 9.00 a.m. 23 24 25"
    }
  ],
