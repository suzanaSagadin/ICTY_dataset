      "id": 4,
      "speaker": "MR. MISETIC",
      "role": "counsel",
      "type": "statement",
      "text": "Your Honour, I believe, to remind Your Honour to call the case."
    },
    {
      "id": 5,
      "speaker": "JUDGE ORIE",
      "role": "judge",
      "type": "statement",
      "text": "Yes. Second time in seven years. Mr. Registrar."
    },
