      "speaker": "MR. STRINGER",
      "role": "counsel",
      "type": "statement",
      "text": "Good morning, Mr. President, Your Honour Judge Hall. For the Prosecution, Douglas Stringer and Thomas Laugel."
    },
    {
      "id": 5,
      "speaker": "JUDGE DELVOIE",
      "role": "judge",
      "type": "statement",
      "text": "Thank you. Mr. Zivanovic."
    },
    {
      "id": 6,
      "speaker": "MR. ZIVANOVIC",
      "role": "counsel",
      "type": "statement",
      "text": "Good morning, Your Honours. For the Defence of Goran Hadzic, Zoran Zivanovic and Christopher Gosnell."
    },
    {
      "id": 7,
      "speaker": "JUDGE DELVOIE",
      "role": "judge",
      "type": "statement",
      "text": "Thank you. Mr. Zivanovic, are you ready for your next witness?"
