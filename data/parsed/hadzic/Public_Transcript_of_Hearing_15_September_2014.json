      "role": "judge",
      "type": "statement",
      "text": "Good morning to everyone in and around the courtroom. Madam Registrar, may we have the appearances, please. No, sorry, could you call the case, please."
    },
    {
      "id": 2,
      "speaker": "THE REGISTRAR",
      "role": "registrar",
      "type": "statement",
      "text": "Good morning, Your Honours. This is case IT-04-75-T, the Prosecutor versus Goran Hadzic. Thank you."
    },
    {
      "id": 3,
      "speaker": "JUDGE DELVOIE",
      "role": "judge",
      "type": "statement",
      "text": "Thank you. Appearances, please, starting with the Prosecution."
    },
    {
