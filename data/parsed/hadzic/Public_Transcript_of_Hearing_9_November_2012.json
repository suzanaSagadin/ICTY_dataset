      "id": 2,
      "speaker": "THE REGISTRAR",
      "role": "registrar",
      "type": "statement",
      "text": "Good morning, Your Honours. This is case number IT-04-75-T, the Prosecutor versus Goran Hadzic. Thank you."
    },
    {
      "id": 3,
      "speaker": "JUDGE DELVOIE",
      "role": "judge",
      "type": "statement",
      "text": "Thank you. May we have the appearances, please, starting with the Prosecution."
    },
    {
      "id": 4,
      "speaker": "MR. OLMSTED",
      "role": "counsel",
      "type": "statement",
      "text": "Good morning, Your Honours. Matthew Olmsted and Thomas Laugel, our Case Manager, for the Prosecution."
    },
    {
      "id": 5,
      "speaker": "JUDGE DELVOIE",
      "role": "judge",
      "type": "statement",
      "text": "Thank you. For the Defence, please."
    },
    {
      "id": 6,
      "speaker": "MR. ZIVANOVIC",
      "role": "counsel",
      "type": "statement",
      "text": "Good morning, Your Honours. For the Defence of Goran Hadzic, Zoran Zivanovic and Christopher Gosnell."
    },
    {
      "id": 7,
      "speaker": "JUDGE DELVOIE",
      "role": "judge",
      "type": "statement",
      "text": "Thank you. Can we go into closed session, please. The witness may be brought in. Thank you."
    },
    {
      "id": 8,
